# All settings are optional. No API keys are needed: shop search uses public
# OpenStreetMap services (Overpass, with Nominatim as fallback).
# CROP_DOCTOR_DATA_DIR=./data                    # SQLite DB + uploaded photos
# CROP_DOCTOR_MODEL_DIR=./model
# CROP_DOCTOR_MIN_CONFIDENCE=0.70                # below this the result is "uncertain"
# CROP_DOCTOR_BLUR_THRESHOLD=15
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# CROP_DOCTOR_USER_AGENT=AICropDoctor/1.0 (contact: you@example.org)   # OSM policy asks for a contact
